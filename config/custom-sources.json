{
  "_readme": "Custom sources: software that is not in winget-pkgs or Homebrew and is read straight from the publisher's own release feeds. Every run of `npm run ingest` / `npm run daily` re-checks each enabled source (scripts/custom.mjs). Each source has an adapter in scripts/sources/<adapter>.mjs that turns the feeds into versions and installers; the `app` block is what the feeds do not say (name, publisher, license, links). Anything in `app` is hand-written from the publisher's own pages. Nothing here is guessed. `app.icon_url` (optional) is the publisher's own icon, fetched by scripts/icons.mjs (PNG, JPEG, WebP, GIF or ICO, https only, 400 KB at most).",
  "sources": [
    {
      "id": "cockroachdb",
      "enabled": true,
      "adapter": "cockroachdb",
      "slug": "cockroachdb",
      "feeds": {
        "releases": "https://binaries.cockroachdb.com/releases/v1/releases.json",
        "series": "https://binaries.cockroachdb.com/releases/v1/series.json"
      },
      "download_base": "https://binaries.cockroachdb.com",
      "file_prefix": "cockroach",
      "release_notes_url": "https://docs.cockroachlabs.com/docs/releases/{series}",
      "max_versions": 50,
      "app": {
        "name": "CockroachDB",
        "publisher": "Cockroach Labs",
        "summary": "CockroachDB — the cloud native, distributed SQL database designed for high availability, effortless scale, and control over data placement.",
        "tags": [
          "cockroachdb",
          "database",
          "distributed-database",
          "go",
          "sql"
        ],
        "pricing": "free-to-download",
        "icon_url": "https://www.cockroachlabs.com/icon1.png",
        "license": {
          "name": "CockroachDB Software License",
          "url": "https://github.com/cockroachdb/cockroach/blob/master/LICENSE"
        },
        "urls": {
          "homepage": "https://www.cockroachlabs.com",
          "publisher": "https://www.cockroachlabs.com",
          "source_code": "https://github.com/cockroachdb/cockroach",
          "release_notes": "https://docs.cockroachlabs.com/docs/releases",
          "purchase": "https://www.cockroachlabs.com/pricing/",
          "documentation": [
            {
              "label": "Documentation",
              "url": "https://docs.cockroachlabs.com/docs"
            },
            {
              "label": "Install CockroachDB",
              "url": "https://docs.cockroachlabs.com/docs/stable/install-cockroachdb"
            },
            {
              "label": "Licensing FAQs",
              "url": "https://docs.cockroachlabs.com/docs/stable/licensing-faqs"
            }
          ]
        }
      }
    },
    {
      "id": "ableton-live",
      "enabled": true,
      "adapter": "ableton",
      "product": "live",
      "slug": "ableton-live",
      "feeds": {
        "releases": "https://www.ableton.com/en/release-notes/live-12/",
        "notes": [
          "https://www.ableton.com/en/release-notes/live-12/",
          "https://www.ableton.com/en/release-notes/live-11/",
          "https://www.ableton.com/en/release-notes/live-10/"
        ],
        "cask_api": "https://formulae.brew.sh/api/cask/"
      },
      "casks": [
        "ableton-live-suite",
        "ableton-live-standard",
        "ableton-live-intro",
        "ableton-live-lite",
        "ableton-live-suite@11",
        "ableton-live-standard@11",
        "ableton-live-intro@11",
        "ableton-live-lite@11",
        "ableton-live-suite@10"
      ],
      "download_base": "https://cdn-downloads.ableton.com/channels",
      "editions": [
        "Suite",
        "Standard",
        "Intro",
        "Lite",
        "Trial"
      ],
      "verification_label": "Ableton publishes no checksums for these downloads. Mac hashes are the ones Homebrew casks pin, where a cask exists for that version; the other files list no hash, and for the newest version we download each file and compute its SHA-256 ourselves.",
      "app": {
        "name": "Ableton Live",
        "publisher": "Ableton AG",
        "summary": "Ableton Live: a digital audio workstation for making, recording, arranging and performing music, in Suite, Standard, Intro and Lite editions.",
        "description": "Ableton Live is a digital audio workstation for composing, recording, editing and performing music. Its Session View is built for trying ideas and improvising, and its Arrangement View for putting a track together on a timeline.\nLive comes in several editions: Suite, Standard, Intro and Lite. Every version on this page lists the editions that Ableton still serves, for Windows and for Mac, and older versions of Live 12, 11 and 10 stay available.\nThe download links go straight to Ableton’s download servers and need no login here, but using Live does: Ableton’s own archive says you need an Ableton account to use any version, including Lite and the free trial. The free trial of Live Suite lasts 30 days.",
        "tags": [
          "ableton",
          "live",
          "daw",
          "music-production",
          "audio",
          "midi",
          "recording"
        ],
        "pricing": "paid",
        "icon_url": "https://cdn-resources.ableton.com/80bA26cPQ1hEJDFjpUKntxfqdmG3ZykO/static/images/apple-touch-icon.fb3597184cb0.png",
        "license": {
          "name": "Proprietary (Ableton End User License Agreement)",
          "url": "https://www.ableton.com/en/eula/"
        },
        "urls": {
          "homepage": "https://www.ableton.com/en/live/",
          "publisher": "https://www.ableton.com/",
          "release_notes": "https://www.ableton.com/en/release-notes/live-12/",
          "purchase": "https://www.ableton.com/en/shop/live/",
          "documentation": [
            {
