# Copy this file to .env (git-ignored) and fill in the values you need.
# Nothing here is needed to build and preview the site.

# VirusTotal: a free API key from https://www.virustotal.com/ (about 4 lookups a minute).
# Used by `npm run virustotal` and the VirusTotal step of `npm run daily`.
VT_API_KEY=

# Deploy over SSH with rsync. Log in with an SSH key; the deploy never uses a password.
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PATH=
